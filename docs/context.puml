@startuml context
' Подключение библиотеки C4-PlantUML (уровень контекста)

!include <C4/C4_Context>

title Диаграмма контекста: система «Тёплый дом» (текущее состояние)

Person(user, "Пользователь", "Владелец дома. Управляет отоплением и проверяет температуру")
Person(installer, "Специалист по установке", "Выезжает к клиенту и подключает отопление к системе")

System(heating_system, "Система «Тёплый дом»", "Монолит на Go + PostgreSQL. Управление отоплением и мониторинг температуры. Всё взаимодействие синхронное")

System_Ext(devices, "Устройство в доме", "Датчики температуры и контроллер системы отопления")

Rel(user, heating_system, "Включает/выключает отопление, задаёт температуру, смотрит показания", "HTTPS, синхронно")
Rel(installer, heating_system, "Регистрирует дом и устройства клиента")
Rel(installer, devices, "Устанавливает и настраивает на месте")
Rel(heating_system, devices, "Отправляет команды управления и запрашивает текущую температуру", "Синхронный запрос сервер → устройство")

@enduml
